<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="198dp" android:layout_marginHorizontal="20dp" android:layout_marginVertical="10dp" app:cardBackgroundColor="#EEEBE6" app:cardCornerRadius="20dp" app:cardElevation="5dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="11dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
            <TextView android:id="@+id/storeCatalogName" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:maxLines="1" android:textColor="@color/primary_blue" android:textSize="20sp" android:fontFamily="@font/montserrat_bold" />
            <TextView android:id="@+id/storeCatalogRating" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#777777" android:textSize="12sp" android:fontFamily="@font/montserrat_medium" />
        </LinearLayout>
        <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="6dp" android:background="#D2D2D2" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="9dp" android:orientation="horizontal">
            <ImageView android:id="@+id/storeCatalogImage" android:layout_width="110dp" android:layout_height="126dp" android:contentDescription="Store photo" android:scaleType="centerCrop" />
            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="10dp" android:orientation="vertical">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                    <TextView android:id="@+id/storeCatalogTagOne" android:layout_width="0dp" android:layout_height="30dp" android:layout_weight="1" android:gravity="center" android:textColor="@color/white" android:textSize="11sp" android:fontFamily="@font/montserrat_bold" />
                    <TextView android:id="@+id/storeCatalogTagTwo" android:layout_width="0dp" android:layout_height="30dp" android:layout_marginStart="6dp" android:layout_weight="1" android:gravity="center" android:textColor="@color/white" android:textSize="11sp" android:fontFamily="@font/montserrat_bold" />
                </LinearLayout>
                <TextView android:id="@+id/storeCatalogLocation" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:drawableStart="@drawable/ic_location" android:drawablePadding="4dp" android:ellipsize="end" android:maxLines="1" android:textColor="#777777" android:textSize="11sp" android:fontFamily="@font/montserrat_medium" />
                <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="7dp" android:background="#D2D2D2" />
                <TextView android:id="@+id/storeCatalogDescription" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:ellipsize="end" android:maxLines="2" android:textColor="@color/black" android:textSize="11sp" android:fontFamily="@font/montserrat_medium" />
                <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="7dp" android:background="#D2D2D2" />
                <TextView android:id="@+id/storeCatalogMeta" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="#777777" android:textSize="11sp" android:fontFamily="@font/montserrat_medium" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
