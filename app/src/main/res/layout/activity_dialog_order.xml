<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="300dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="@drawable/bg_order"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="28dp"
    android:paddingBottom="24dp">

    <!-- Success Icon -->
    <ImageView
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:src="@drawable/ic_success_green"
        android:contentDescription="Order successful" />

    <!-- Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="@font/montserrat_bold"
        android:text="Order Successful!"
        android:textColor="#111111"
        android:textSize="17sp" />

    <!-- Green underline -->
    <View
        android:layout_width="52dp"
        android:layout_height="2dp"
        android:layout_marginTop="8dp"
        android:background="#4E927A" />

    <!-- Description -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:fontFamily="@font/montserrat"
        android:gravity="center"
        android:lineSpacingExtra="2dp"
        android:text="Your book order has been placed&#10;successfully."
        android:textColor="#555555"
        android:textSize="10sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/montserrat"
        android:gravity="center"
        android:text="A receipt has been sent to your e-mail"
        android:textColor="#555555"
        android:textSize="9sp" />

    <!-- Receipt Box -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_receipt_email"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <ImageView
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:src="@drawable/ic_email_green"
            android:contentDescription="Email" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/montserrat"
                android:text="Receipt sent to:"
                android:textColor="#777777"
                android:textSize="8sp" />

            <TextView
                android:id="@+id/tvReceiptEmail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/montserrat_bold"
                android:text="reeders@mail.com"
                android:textColor="#222222"
                android:textSize="8sp" />

        </LinearLayout>

    </LinearLayout>

    <!-- DClassics Logo -->
    <ImageView
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:layout_marginTop="15dp"
        android:src="@drawable/logo_dclassics"
        android:contentDescription="DClassics" />

    <!-- Divider -->
    <!-- View Book -->
    <LinearLayout
        android:id="@+id/btnViewBookLayout"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_view_book_button"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_eye"
            android:contentDescription="View Book Icon" />

        <TextView
            android:id="@+id/btnViewBook"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="@font/montserrat_medium"
            android:text="View Book"
            android:textColor="#214467"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Continue Ordering -->
    <LinearLayout
        android:id="@+id/btnContinueOrderingLayout"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_continue_ordering_button"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_cart"
            android:contentDescription="Cart Icon" />

        <TextView
            android:id="@+id/btnContinueOrdering"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="@font/montserrat_medium"
            android:text="Continue Ordering"
            android:textColor="#FFFFFF"
            android:textSize="10sp" />
    </LinearLayout>

</LinearLayout>