<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="138dp"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="8dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="20dp"
    app:cardElevation="5dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal">
        <ImageView android:id="@+id/bookCatalogImage" android:layout_width="76dp" android:layout_height="108dp" android:layout_margin="8dp" android:contentDescription="Book cover" android:scaleType="centerCrop" />
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center_vertical" android:orientation="vertical">
            <TextView android:id="@+id/bookCatalogTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="2" android:textColor="@color/black" android:textSize="13sp" android:fontFamily="@font/montserrat_bold" />
            <TextView android:id="@+id/bookCatalogAuthor" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:textColor="#666666" android:textSize="12sp" android:fontFamily="@font/montserrat_medium" />
            <TextView android:id="@+id/bookCatalogCategory" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="start" android:layout_marginTop="8dp" android:background="@drawable/bg_category_chip" android:textColor="@color/white" android:textSize="10sp" android:fontFamily="@font/montserrat_bold" />
            <TextView android:id="@+id/bookCatalogRating" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="#444444" android:textSize="10sp" android:fontFamily="@font/montserrat_medium" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/bookActionPanel"
            android:layout_width="48dp"
            android:layout_height="match_parent"
            android:background="@color/secondary_blue"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/bookActionButtons"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBookDetail"
                    android:layout_width="72dp"
                    android:layout_height="28dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:paddingHorizontal="0dp"
                    android:text="Detail"
                    android:textAllCaps="false"
                    android:textColor="@color/black"
                    android:textSize="11sp"
                    app:backgroundTint="#EEEEEE"
                    app:cornerRadius="18dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBookOrder"
                    android:layout_width="72dp"
                    android:layout_height="28dp"
                    android:layout_marginTop="10dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:paddingHorizontal="0dp"
                    android:text="Order"
                    android:textAllCaps="false"
                    android:textColor="@color/black"
                    android:textSize="11sp"
                    app:backgroundTint="#EEEEEE"
                    app:cornerRadius="18dp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/bookCatalogArrow"
                android:layout_width="48dp"
                android:layout_height="match_parent"
                android:contentDescription="Show book actions"
                android:padding="12dp"
                android:src="@drawable/ic_catalog_chevron_right"
                app:tint="@color/white" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
