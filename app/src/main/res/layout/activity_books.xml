<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/booksDrawer"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/primary_background" android:orientation="vertical">
        <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="92dp" android:background="@color/secondary_background" android:elevation="5dp" android:paddingHorizontal="20dp" android:paddingTop="20dp">
            <ImageButton android:id="@+id/btnMenu" android:layout_width="30dp" android:layout_height="30dp" android:background="@android:color/transparent" android:contentDescription="Open navigation" android:src="@drawable/ic_menu" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" />
            <ImageView android:layout_width="170dp" android:layout_height="42dp" android:contentDescription="DClassics" android:src="@drawable/logo_dclassics_text" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" />
            <ImageView android:layout_width="30dp" android:layout_height="30dp" android:contentDescription="Profile" android:src="@drawable/logo_dclassics" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="20dp" android:layout_marginTop="20dp" android:text="Books Catalog" android:textColor="@color/black" android:textSize="32sp" android:fontFamily="@font/montserrat_bold" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="20dp" android:layout_marginTop="2dp" android:drawableStart="@drawable/circle" android:drawablePadding="8dp" android:gravity="center_vertical" android:text="Explore Timeless Book Stories" android:textColor="#777777" android:textSize="19sp" android:fontFamily="@font/montserrat_medium" />

        <EditText android:id="@+id/etSearchBooks" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginHorizontal="20dp" android:layout_marginTop="16dp" android:background="@drawable/bg_search" android:drawableEnd="@drawable/ic_search_catalog" android:drawablePadding="12dp" android:hint="Search Books..." android:inputType="text" android:maxLines="1" android:paddingHorizontal="16dp" android:textColor="@color/black" android:textColorHint="#777777" android:textSize="14sp" android:fontFamily="@font/montserrat" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginHorizontal="20dp" android:layout_marginTop="18dp" android:background="@drawable/bg_filter_unselected" android:orientation="horizontal">
            <TextView android:id="@+id/btnNonFiction" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/bg_filter_selected" android:gravity="center" android:text="Non-Fiction" android:textColor="@color/white" android:textSize="14sp" android:fontFamily="@font/montserrat_bold" />
            <TextView android:id="@+id/btnFiction" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="Fiction" android:textColor="@color/secondary_blue" android:textSize="14sp" android:fontFamily="@font/montserrat_bold" />
        </LinearLayout>
        <TextView android:id="@+id/tvBookCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="24dp" android:layout_marginTop="14dp" android:textColor="#444444" android:textSize="12sp" android:fontFamily="@font/montserrat_medium" />
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvBooks" android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="4dp" android:layout_weight="1" android:clipToPadding="false" android:paddingBottom="14dp" />
    </LinearLayout>

    <include layout="@layout/sidebar" android:layout_gravity="start" />
</androidx.drawerlayout.widget.DrawerLayout>
